# ---- Reasoning model (any OpenAI-compatible endpoint; local Ollama by default) ----
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_KEY=ollama
LLM_TIMEOUT_SECONDS=180
LLM_MAX_ATTEMPTS=3

# ---- Research sources ----
# Web search: "tavily" or "none". Without a key, web search is skipped with a warning.
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Optional, raises the GitHub search limit from 10 to 30 requests per minute.
GITHUB_TOKEN=
# Optional. OpenAlex works without a key but anonymous use has a small daily allowance
# (roughly 100 searches); a free API key raises it. The email joins the "polite pool".
OPENALEX_API_KEY=
OPENALEX_EMAIL=
# Optional second paper source.
SEMANTIC_SCHOLAR_ENABLED=false
SEMANTIC_SCHOLAR_API_KEY=
# "live" uses the real APIs; "mock" uses clearly labelled sample data for offline work.
RESEARCH_MODE=live
HTTP_TIMEOUT_SECONDS=20

# ---- Limits (keep API and model usage bounded) ----
MAX_RESEARCH_ROUNDS=3
MAX_PROBLEMS=4
MAX_CANDIDATES=8
MAX_FINAL_IDEAS=3
MAX_CRITIC_ROUNDS=2
MAX_SEARCH_RESULTS_PER_QUERY=5
MAX_QUERIES_PER_SOURCE=3
MIN_FINAL_SCORE=55

# Ranking weights (normalised automatically). Leave empty for the defaults.
# RANKING_WEIGHTS=problem_relevance:0.20,evidence_strength:0.20,differentiation:0.15,feasibility:0.20,impact:0.10,learning_value:0.10,prototype_clarity:0.05

# ---- Storage ----
# Relative to where the service runs. Defaults to data/idea_engine.db inside this folder.
# DATABASE_PATH=data/idea_engine.db
