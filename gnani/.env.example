# These values go in the SHARED veya/.env (one level up), together with the
# app's EXPO_PUBLIC_* values. Never commit the real .env file.

# ---- Local Qwen model through Ollama (OpenAI-compatible API) ----
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:7b

# ---- Plans ----
VEYA_DEFAULT_PLAN=free
# VEYA_PAID_USERS=user_abc123
# VEYA_FREE_MAX_PROJECTS=3
# VEYA_FREE_IMAGES=false

# ---- Gnani (Vachana) speech services ----
GNANI_API_KEY=your-gnani-api-key
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_ENDPOINT=/stt/v3
GNANI_TTS_ENDPOINT=/api/v1/tts/inference

# ---- VEYA app integration ----
# Browser origins allowed by CORS (Expo web dev server). Native apps ignore CORS.
VEYA_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# SQLite file for saved projects (default: data/veya_projects.db)
# VEYA_DB_PATH=data/veya_projects.db
